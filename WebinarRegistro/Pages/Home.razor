@page "/"
@using WebinarRegistro.Models
@inject WebinarRegistro.Services.AttendeeService AttendeeService

<PageTitle>Registro</PageTitle>

<div class="container py-4">
	<div class="registration-card">
		<div class="text-center mb-4">
			<h1 class="h2 mb-3 text-primary">
				<span class="icon-user-plus me-2"></span>
				Registro de Asistentes
			</h1>
			<p class="text-muted">Complete el formulario para registrarse al webinario</p>
		</div>
		
		<EditForm Model="_model" OnValidSubmit="OnSubmitAsync">
			<DataAnnotationsValidator />
			<ValidationSummary class="alert alert-danger" />
			
			<div class="row g-3">
				<div class="col-md-6">
					<label class="form-label">
						<span class="icon-user me-1"></span>
						Nombre *
					</label>
					<div class="input-group-icon">
						<span class="icon-user icon"></span>
						<InputText class="form-control" @bind-Value="_model.Nombre" placeholder="Ingrese su nombre completo" />
					</div>
				</div>
				<div class="col-md-6">
					<label class="form-label">
						<span class="icon-building me-1"></span>
						Empresa
					</label>
					<div class="input-group-icon">
						<span class="icon-building icon"></span>
						<InputText class="form-control" @bind-Value="_model.Empresa" placeholder="Nombre de su empresa" />
					</div>
				</div>
				<div class="col-md-6">
					<label class="form-label">
						<span class="icon-phone me-1"></span>
						Teléfono
					</label>
					<div class="input-group-icon">
						<span class="icon-phone icon"></span>
						<InputText class="form-control" @bind-Value="_model.Telefono" placeholder="+1 234 567 8900" />
					</div>
				</div>
				<div class="col-md-6">
					<label class="form-label">
						<span class="icon-envelope me-1"></span>
						Correo *
					</label>
					<div class="input-group-icon">
						<span class="icon-envelope icon"></span>
						<InputText class="form-control" @bind-Value="_model.Correo" type="email" placeholder="su.email@ejemplo.com" />
					</div>
				</div>
				<div class="col-12 d-flex gap-2 mt-4">
					<button class="btn btn-primary btn-lg" disabled="@_saving">
						@if (_saving)
						{
							<span class="icon-sync icon-spinner me-2"></span>
							<span>Guardando...</span>
						}
						else
						{
							<span class="icon-check me-2"></span>
							<span>Registrar</span>
						}
					</button>
					<button type="button" class="btn btn-outline-secondary btn-lg" @onclick="ResetForm" disabled="@_saving">
						<span class="icon-eraser me-2"></span>
						Limpiar
					</button>
				</div>
			</div>
		</EditForm>
		
		@if(_saved)
		{
			<div class="alert alert-success mt-4 p-3">
				<span class="icon-check me-2"></span>
				¡Registro guardado exitosamente! ✅
			</div>
		}
		
		<div class="mt-4 p-3 bg-light rounded">
			<small class="text-muted">
				<span class="icon-shield me-1"></span>
				Al registrarte aceptas el uso de tus datos únicamente para la gestión del webinario.
			</small>
		</div>
	</div>
</div>

@code {
	private Attendee _model = new();
	private bool _saving;
	private bool _saved;

	private async Task OnSubmitAsync()
	{
		_saving = true;
		_saved = false;
		await AttendeeService.AddAsync(_model);
		_model = new();
		_saving = false;
		_saved = true;
		StateHasChanged();
		await Task.Delay(3000);
		_saved = false;
		StateHasChanged();
	}

	private void ResetForm()
	{
		_model = new();
	}
}
