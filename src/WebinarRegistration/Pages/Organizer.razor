@page "/organizer"
@inject WebinarRegistration.Services.IAttendeeService AttendeeService

<div class="page-header">
    <h1>Panel de Organizador</h1>
    <p>Gestiona y consulta los asistentes registrados. Total registrados: <strong>@_count</strong></p>
</div>

<AttendeeList />

@code {
    private int _count;
    protected override async Task OnInitializedAsync()
    {
        _count = await AttendeeService.CountAsync();
    }
}